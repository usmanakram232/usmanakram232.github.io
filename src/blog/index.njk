</head>
<body>

  <nav class="site-nav" aria-label="Site navigation">
    <a href="/">M. Usman Akram</a>
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to light mode" aria-pressed="false">
      <svg class="icon-sun" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
      <svg class="icon-moon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>
  </nav>

  <main>
    <div class="page-wrap">

      <header class="page-header">
        <h1>Writing</h1>
        <p>Technical writing on systems, tooling, and the odd rabbit hole worth documenting.</p>
      </header>

      {%- set seriesPosts  = collections.post | hasPart  | sort(false, false, "data.part") -%}
      {%- set standalonePosts = collections.post | noPart | sort(true, false, "data.date") -%}

      <!-- ── Series: chapter-list with connecting rail ── -->
      <section class="series-block" aria-label="Series: From dotfiles to declarative desktops">
        <span class="section-label section-label--series">Series</span>

        <div class="series-heading">
          <div class="series-heading-text">
            <h2>From dotfiles to declarative desktops</h2>
            <p>A Linux workstation evolved from shell scripts to NixOS, with agentic tooling and defence-in-depth security.</p>
          </div>
          <img src="/assets/img/declarative-workstations.png"
               alt="Architecture diagram: declarative workstations and secure AI"
               class="series-thumb expandable-img"
               loading="lazy"
               width="96" height="54" />
        </div>

        <ol class="chapter-list" aria-label="Series chapters">
          {%- for post in seriesPosts -%}
          <li class="chapter-item">
            <a href="{{ post.url }}">
              <div class="chapter-num" aria-hidden="true">
                <span>{{ post.data.part | zeroPad }}</span>
              </div>
              <div class="chapter-body">
                <div class="chapter-title">{{ post.data.title }}</div>
                <div class="chapter-desc">{{ post.data.description }}</div>
              </div>
            </a>
          </li>
          {%- endfor -%}
        </ol>
      </section>

      <!-- ── Standalone notes: flat list, subordinate ── -->
      {%- if standalonePosts.length -%}
      <section class="standalone-block" aria-label="Notes">
        <span class="section-label section-label--notes">Notes</span>

        <ul class="note-list">
          {%- for post in standalonePosts -%}
          <li class="note-item">
            <a href="{{ post.url }}">
              <div class="note-content">
                <div class="note-title">{{ post.data.title }}</div>
                <div class="note-desc">{{ post.data.description }}</div>
              </div>
              <span class="note-arrow" aria-hidden="true">&#8594;</span>
            </a>
          </li>
          {%- endfor -%}
        </ul>
      </section>
      {%- endif -%}

      <footer class="page-footer">
        <a href="/">← Back to home</a>
      </footer>

    </div>
  </main>

  <!-- ── Image overlay ── -->
  <div id="img-overlay" class="img-overlay" role="dialog" aria-modal="true" aria-label="Image expanded view">
    <button class="overlay-close" aria-label="Close expanded image">&times;</button>
    <img id="overlay-img" src="" alt="" />
  </div>

  <script>
    // ── Theme toggle ──
    (function () {
      var btn = document.getElementById('theme-toggle');
      if (!btn) return;
      function sync(theme) {
        var dark = theme === 'dark';
        btn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
        btn.setAttribute('aria-pressed', String(!dark));
      }
      sync(document.documentElement.getAttribute('data-theme') || 'dark');
      btn.addEventListener('click', function () {
        var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
        sync(next);
      });
    })();

    // ── Expandable image overlay ──
    (function () {
      var overlay = document.getElementById('img-overlay');
      var overlayImg = document.getElementById('overlay-img');
      var closeBtn = overlay.querySelector('.overlay-close');
      if (!overlay || !overlayImg || !closeBtn) return;

      function open(src, alt) {
        overlayImg.src = src;
        overlayImg.alt = alt || '';
        overlay.classList.add('open');
        document.body.style.overflow = 'hidden';
      }

      function close() {
        overlay.classList.remove('open');
        document.body.style.overflow = '';
        // Clear src after transition so video memory isn't held
        setTimeout(function () { overlayImg.src = ''; }, 300);
      }

      // Close on button click
      closeBtn.addEventListener('click', close);

      // Close on backdrop click
      overlay.addEventListener('click', function (e) {
        if (e.target === overlay) close();
      });

      // Close on Escape
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && overlay.classList.contains('open')) close();
      });

      // Wire up all expandable-img elements on this page
      function wire() {
        var imgs = document.querySelectorAll('.expandable-img');
        for (var i = 0; i < imgs.length; i++) {
          imgs[i].addEventListener('click', function () {
            open(this.src, this.alt);
          });
        }
      }
      wire();
    })();
  </script>
</body>
</html>
