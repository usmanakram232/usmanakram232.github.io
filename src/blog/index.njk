---
layout: false
title: Writing
permalink: /blog/
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <!-- no-FOUC: apply saved theme before first paint -->
  <script>try{var t=localStorage.getItem('theme')||'dark';document.documentElement.setAttribute('data-theme',t)}catch(e){}</script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Writing · M. Usman Akram</title>
  <meta name="description" content="A nine-part series on building a fully declarative Linux workstation with NixOS, agentic AI tooling, and defence-in-depth security." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,400&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --font-display: 'Cormorant Garamond', Georgia, serif;
      --font-body:    'DM Sans', system-ui, sans-serif;
      --font-mono:    'DM Mono', 'Menlo', monospace;
      --max-prose:    660px;
    }

    /* ── Dark mode — cold precision ── */
    [data-theme="dark"] {
      --bg:        #0b0c10;
      --ink:       #dde1e8;
      --ink-muted: #7f8899;
      --ink-faint: #4d5566;
      --border:    #1c1f2a;
      --accent:    #4a84b8;
      --accent-dim: rgba(74, 132, 184, 0.12);
    }

    /* ── Light mode — cool off-white ── */
    [data-theme="light"] {
      --bg:        #f2f3f6;
      --ink:       #141720;
      --ink-muted: #454d5e;
      --ink-faint: #788093;
      --border:    #d0d4dd;
      --accent:    #2c6fa6;
      --accent-dim: rgba(44, 111, 166, 0.08);
    }

    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: var(--font-body);
      font-weight: 300;
      font-size: 1.05rem;
      line-height: 1.75;
      transition: background-color 0.25s ease, color 0.25s ease;
    }

    /* ── THEME TOGGLE ── */
    .theme-toggle {
      margin-left: auto;
      flex-shrink: 0;
      background: none;
      border: 1px solid var(--ink-faint);
      border-radius: 50%;
      width: 30px;
      height: 30px;
      cursor: pointer;
      color: var(--ink-faint);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      transition: color 0.2s, border-color 0.2s;
    }

    .theme-toggle:hover        { color: var(--ink); border-color: var(--ink-muted); }
    .theme-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
    .theme-toggle svg           { pointer-events: none; display: block; }

    [data-theme="dark"]  .icon-sun  { display: block; }
    [data-theme="dark"]  .icon-moon { display: none; }
    [data-theme="light"] .icon-sun  { display: none; }
    [data-theme="light"] .icon-moon { display: block; }

    /* ── NAV ── */
    .site-nav {
      position: sticky;
      top: 0;
      z-index: 10;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      padding: 0.875rem clamp(1.25rem, 5vw, 2.5rem);
      display: flex;
      align-items: center;
      gap: 0.6rem;
      transition: background-color 0.25s ease;
    }

    .site-nav a {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-faint);
      text-decoration: none;
      transition: color 0.2s;
    }

    .site-nav a:hover { color: var(--ink); }

    /* ── PAGE LAYOUT ── */
    .page-wrap {
      max-width: var(--max-prose);
      margin: 0 auto;
      padding: clamp(3rem, 7vw, 5rem) clamp(1.25rem, 5vw, 2rem);
    }

    .page-header {
      margin-bottom: 3.5rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--border);
    }

    .page-header h1 {
      font-family: var(--font-display);
      font-style: italic;
      font-size: clamp(1.8rem, 4vw, 2.6rem);
      font-weight: 400;
      letter-spacing: -0.02em;
      line-height: 1.1;
      margin-bottom: 0.75rem;
    }

    .page-header p {
      color: var(--ink-muted);
      font-size: 0.97rem;
    }

    /* ── SECTION LABELS ── */
    .section-label {
      font-family: var(--font-mono);
      font-size: 0.66rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      display: block;
      margin-bottom: 1.25rem;
    }

    /* ── SERIES BLOCK ── */
    .series-block {
      margin-bottom: 4rem;
    }

    .section-label--series { color: var(--accent); }

    .series-heading {
      display: flex;
      align-items: flex-start;
      gap: 1.25rem;
      margin-bottom: 2rem;
    }

    .series-heading-text { flex: 1; min-width: 0; }

    .series-heading h2 {
      font-family: var(--font-display);
      font-size: clamp(1.1rem, 2.5vw, 1.35rem);
      font-weight: 400;
      color: var(--ink);
      letter-spacing: -0.01em;
      margin-bottom: 0.4rem;
    }

    .series-heading p {
      font-size: 0.9rem;
      color: var(--ink-muted);
      line-height: 1.65;
      max-width: 44ch;
    }

    .series-thumb {
      flex-shrink: 0;
      width: 96px;
      height: auto;
      border-radius: 4px;
      border: 1px solid var(--border);
      margin-top: 0.2rem;
      cursor: pointer;
      transition: border-color 0.2s, opacity 0.2s;
    }

    .series-thumb:hover {
      border-color: var(--accent);
      opacity: 0.85;
    }

    @media (max-width: 480px) {
      .series-thumb { width: 64px; }
    }

    /* ── EXPANDABLE IMAGE OVERLAY ── */
    .img-overlay {
      position: fixed;
      inset: 0;
      z-index: 100;
      background: rgba(0, 0, 0, 0.88);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
      padding: clamp(1rem, 4vw, 2.5rem);
    }

    .img-overlay.open {
      opacity: 1;
      pointer-events: auto;
    }

    .img-overlay img {
      max-width: 100%;
      max-height: 100%;
      width: auto;
      height: auto;
      object-fit: contain;
      border-radius: 4px;
      box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5);
    }

    .img-overlay .overlay-close {
      position: absolute;
      top: 1rem;
      right: 1.5rem;
      background: none;
      border: none;
      color: #fff;
      font-size: 1.5rem;
      cursor: pointer;
      opacity: 0.5;
      transition: opacity 0.2s;
      font-family: var(--font-mono, monospace);
      line-height: 1;
    }

    .img-overlay .overlay-close:hover { opacity: 1; }

    @media (prefers-reduced-motion: reduce) {
      .img-overlay { transition-duration: 0.01ms !important; }
    }

    /* ── CHAPTER LIST — series-specific treatment ── */
    /*
     * Visual language: numbered chapters with a connecting left rail.
     * Communicates ORDER and CONTINUITY — you're meant to read these
     * in sequence, they're chapters in a book, not independent links.
     */
    .chapter-list {
      list-style: none;
      position: relative;
    }

    /* The connecting vertical rail through all chapter numbers */
    .chapter-list::before {
      content: '';
      position: absolute;
      left: 1.1rem;
      top: 1.5rem;
      bottom: 1.5rem;
      width: 1px;
      background: var(--border);
    }

    .chapter-item {
      position: relative;
    }

    .chapter-item a {
      display: grid;
      grid-template-columns: 2.5rem 1fr;
      gap: 1.25rem;
      align-items: start;
      padding: 1.1rem 0;
      text-decoration: none;
      color: inherit;
    }

    .chapter-num {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.06em;
      color: var(--accent);
      padding-top: 0.3rem;
      text-align: center;
      position: relative;
      z-index: 1;
      /* Small circle to sit on the rail */
      display: flex;
      align-items: flex-start;
      justify-content: center;
    }

    /* Circle node on the rail */
    .chapter-num::before {
      content: '';
      position: absolute;
      top: 0.55rem;
      left: 50%;
      transform: translateX(-50%);
      width: 7px;
      height: 7px;
      border-radius: 50%;
      border: 1px solid var(--accent);
      background: var(--bg);
      z-index: 1;
    }

    /* Hide the number text itself — number shown via ::after */
    .chapter-num span {
      position: relative;
      z-index: 2;
      line-height: 1;
      margin-top: 1.25rem; /* push below the circle node */
    }

    .chapter-body {
      padding: 0;
    }

    .chapter-title {
      font-size: 0.97rem;
      font-weight: 400;
      color: var(--ink);
      margin-bottom: 0.3rem;
      line-height: 1.4;
      transition: color 0.2s;
    }

    .chapter-desc {
      font-size: 0.85rem;
      color: var(--ink-muted);
      line-height: 1.55;
    }

    .chapter-item a:hover .chapter-title { color: var(--accent); }
    .chapter-item a:hover .chapter-num::before { background: var(--accent); }

    /* ── STANDALONE POSTS — quieter, secondary ── */
    /*
     * Visual language: flat text links, no rail, no numbers.
     * These are independent pieces — no implied order.
     */
    .standalone-block {
      padding-top: 3rem;
      border-top: 1px solid var(--border);
    }

    .section-label--notes { color: var(--ink-faint); }

    .note-list {
      list-style: none;
    }

    .note-item {
      border-bottom: 1px solid var(--border);
    }

    .note-item:first-child {
      border-top: 1px solid var(--border);
    }

    .note-item a {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      padding: 1rem 0;
      text-decoration: none;
      color: inherit;
    }

    .note-content { flex: 1; }

    .note-title {
      font-size: 0.93rem;
      font-weight: 300;
      color: var(--ink-muted);
      margin-bottom: 0.2rem;
      line-height: 1.4;
      transition: color 0.2s;
    }

    .note-desc {
      font-size: 0.82rem;
      color: var(--ink-faint);
      line-height: 1.5;
    }

    .note-arrow {
      color: var(--ink-faint);
      opacity: 0;
      font-size: 0.9rem;
      flex-shrink: 0;
      transition: opacity 0.2s, color 0.2s;
    }

    .note-item a:hover .note-title  { color: var(--ink); }
    .note-item a:hover .note-arrow  { opacity: 1; color: var(--accent); }

    /* ── FOOTER ── */
    .page-footer {
      margin-top: 4rem;
      padding-top: 2rem;
      border-top: 1px solid var(--border);
    }

    .page-footer a {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-faint);
      text-decoration: none;
      transition: color 0.2s;
    }

    .page-footer a:hover { color: var(--accent); }

    @media (max-width: 480px) {
      .note-arrow { display: none; }
      /* Simplify chapter rail on small screens */
      .chapter-list::before { left: 0.85rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { transition-duration: 0.01ms !important; }
    }
  </style>
